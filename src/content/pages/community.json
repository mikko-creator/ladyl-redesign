   "heading": "Community Causes",
   "blocks": [
    {
     "type": "p",
     "html": "A few of the local initiatives and coalitions we’re part of to help make Jersey City better for all of its people."
    },
    {
     "type": "img",
     "src": "/assets/photos/ll/unsplash-image-d7ufy08ckku.webp",
