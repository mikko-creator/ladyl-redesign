     "type": "ul",
     "items": [
      "McGinley Square,",
      "West Bergen,",
      "Bergen-Lafayette,",
      "Hackensack River Waterfront",
      "and Droyer’s Point."
     ]
    },
    {
     "type": "p",
     "html": "We’re a <strong>10-20 minute drive</strong> from"
    },
    {
     "type": "ul",
     "items": [
      "Journal Square,",
      "Historic Downtown,",
      "Greenville,",
      "South Kearny,",
      "The Heights,",
      "Curries Woods,",
      "Bayonne",
      "and Constable Hook."
     ]
    },
